{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy decision generated by program",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "action": {
      "enum": [
        "CLARIFY",
        "PROBE",
        "NEXT",
        "END"
      ]
    },
    "reason_code": {
      "enum": [
        "USER_REQUESTED_END",
        "SKIPPED",
        "FOLLOWUP_LIMIT_REACHED",
        "AMBIGUOUS_ANSWER",
        "CONFLICTING_EVIDENCE",
        "MISSING_REQUIRED_DETAIL",
        "ADEQUATE_EVIDENCE",
        "NO_LEGAL_PROBE",
        "ALL_ROOTS_COMPLETED"
      ]
    },
    "reason_summary": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "competency_id": {
              "type": "string",
              "minLength": 1
            },
            "criterion_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "followup_intent": {
              "enum": [
                "clarification",
                "detail",
                "ownership",
                "counterfactual",
                "pushback",
                "reflection",
                null
              ]
            }
          },
          "required": [
            "competency_id",
            "criterion_id",
            "followup_intent"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "observation_id",
    "root_question_id",
    "action",
    "reason_code",
    "reason_summary",
    "target",
    "policy_version"
  ]
}
