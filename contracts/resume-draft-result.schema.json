{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounded resume draft candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "enum": [
              "summary",
              "education",
              "projects",
              "skills",
              "awards",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "item_id",
                "text",
                "claim_ids",
                "reason"
              ]
            }
          }
        },
        "required": [
          "section_id",
          "title",
          "items"
        ]
      }
    },
    "missing_facts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "prompt",
          "reason"
        ]
      }
    },
    "cautions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "schema_version",
    "draft_id",
    "sections",
    "missing_facts",
    "cautions"
  ]
}
