{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable operation event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "operation.started",
        "node.started",
        "node.completed",
        "policy.decided",
        "question.ready",
        "report.ready",
        "coaching.ready",
        "resume_draft.ready",
        "operation.completed",
        "operation.failed",
        "operation.interrupted"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "seq",
    "event_type",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "operation.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "resource_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              }
            },
            "required": [
              "kind",
              "resource_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "node.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "node_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "node.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "node_id",
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "policy.decided"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "CLARIFY",
                  "PROBE",
                  "NEXT",
                  "END"
                ]
              },
              "reason_code": {
                "enum": [
                  "USER_REQUESTED_END",
                  "SKIPPED",
                  "FOLLOWUP_LIMIT_REACHED",
                  "AMBIGUOUS_ANSWER",
                  "CONFLICTING_EVIDENCE",
                  "MISSING_REQUIRED_DETAIL",
                  "ADEQUATE_EVIDENCE",
                  "NO_LEGAL_PROBE",
                  "ALL_ROOTS_COMPLETED"
                ]
              },
              "root_question_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "followup_intent": {
                "enum": [
                  "clarification",
                  "detail",
                  "ownership",
                  "counterfactual",
                  "pushback",
                  "reflection",
                  null
                ],
                "description": "ADR-013：PROBE/CLARIFY 的追问语义。UI 由 action=PROBE 且本字段=pushback 推导 CHALLENGE 展示；不持久化第五种顶层 Action。"
              }
            },
            "required": [
              "action",
              "reason_code",
              "root_question_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "question.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "interview_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "interview_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "report.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "report_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "interview_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "report_id",
              "interview_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "coaching.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "report_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "report_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "report_id",
              "report_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "resume_draft.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resume_draft_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "resume_draft_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "resume_draft_id",
              "resume_draft_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "operation.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
              },
              "resource_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "resource_id",
              "resource_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "operation.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "operation.interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        }
      }
    }
  ]
}
