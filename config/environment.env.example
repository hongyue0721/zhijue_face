# 无密钥模板。复制到项目根 .env.local 后必须 chmod 600；该文件已由 .gitignore 排除。
# live 缺少真实配置时 readiness 必须 not_ready，不得自动回退 fixture。
ZHIJUE_RUN_MODE=live
ZHIJUE_CONFIG_PATH=./config/demo.yaml
ZHIJUE_RUNTIME_DIR=./runtime
ZHIJUE_DATABASE_URL=sqlite:///./runtime/business.db
ZHIJUE_MILVUS_URI=./runtime/knowledge.db
ZHIJUE_API_HOST=127.0.0.1
ZHIJUE_API_PORT=8000
ZHIJUE_API_WORKERS=1
# 所有模型 Workflow（回答分析/回答优化/简历生成/每批材料抽取）的单次执行预算。
# 留空默认按各适配器实际 MODEL_TIMEOUT + 30 秒编排余量计算，至少 60 秒。
# 显式有限正值覆盖默认值；openJiuwen 会话级与外层执行截止同源。
ZHIJUE_MODEL_WORKFLOW_TIMEOUT_SECONDS=
ZHIJUE_MODEL_ENV_FILE=./.env.local

# 可选：M2-02 私有材料 live smoke。只在本机 0600 配置中填写；路径、指纹和
# 预期字符数不得提交或写入公开证据。脚本不会扫描 Downloads 等工作站目录。
ZHIJUE_DEMO_RESUME_PATH=
ZHIJUE_DEMO_RESUME_SHA256=
ZHIJUE_DEMO_RESUME_EXPECTED_CHARACTERS=

# LLM 规范变量。模板不携带密钥；值仅放本机 0600 私密文件。
# chat/completions 请求默认走 SSE 流式（网关 SSE 通道不落实 json_object 强制时
# 显式 MODEL_STREAM=false 走单 JSON 体）：MODEL_TIMEOUT 是单次请求总预算，
# MODEL_STREAM_STALL_SECONDS 是块间静默预算（生效值取两者较小），推理阶段
# token 持续到达，不再出现“整段生成静默等待”导致的假死超时。
# 2026-09-19 已用 `deepseek-flash` + `https://api.deepseek.com` 跑通一次
# M3-01 合成回答业务 Workflow；历史比赛网关上同名模型 503 与本次官方端点
# 不是同一验证。API_BASE 与 EMBEDDING_API_BASE 是两套独立配置；即使指向
# 同一供应商，也默认使用隔离的私密文件和密钥。
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
# 允许 origin 或 origin/v1（OpenAI 兼容网关惯例）；其余路径/query/fragment 拒绝。
API_BASE=https://api.deepseek.com
API_KEY=
MODEL_TIMEOUT=60
MODEL_STREAM_STALL_SECONDS=20
# 部分网关的 SSE 通道不落实 response_format=json_object 强制（实测某些代理流式下
# 输出 Markdown 栅栏或非法转义）。此类网关显式设 false 走单 JSON 体；默认 true 保持
# 长思考网关的块间静默保护。校验逻辑两条路径完全一致。
MODEL_STREAM=true
MODEL_REASONING_EFFORT=low
MODEL_MAX_RETRIES=2

# openJiuwen Knowledge embedding。API_BASE 与 EMBEDDING_API_BASE 分开，禁止共用密钥。
# 该网关按 OpenAI-compatible base 配置，由 openJiuwen OpenAIEmbedding 请求 /embeddings。
# 应用读取 embedding 配置的方式：ZHIJUE_EMBEDDING_ENV_FILE 指向本机 0600 私密文件
# （即本模板复制后的文件）。未设置时 live 模式 readiness=not_ready，不自动回退 fixture。
ZHIJUE_EMBEDDING_ENV_FILE=./.env.local
EMBEDDING_PROVIDER=openjiuwen_api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=https://provider.example/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=1
EMBEDDING_EXPECTED_DIMENSION=1024
KNOWLEDGE_PHASE_TIMEOUT=180

# 必须保持 TLS 校验；如需企业 CA，只配置受控证书路径，不设 false。
EMBEDDING_SSL_VERIFY=true
# EMBEDDING_SSL_CERT=

# 未知供应商价格不得估造；无法取得 usage/cost 时保持 null / NOT_MEASURED。
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
MODEL_PRICE_CURRENCY=

# 不添加 VITE_API_KEY / VITE_LLM_API_KEY 等变量；VITE_* 会进入浏览器构建产物。
